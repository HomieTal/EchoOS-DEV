#!/bin/sh
# SPDX-FileCopyrightText: no
# SPDX-License-Identifier: CC0-1.0
#
# Single entry point for launching the Echo OS installer from the live
# session.  Used by both the "Install Echo OS" desktop shortcut and the
# XDG autostart entry, so there is exactly one launch path to reason
# about.
#
# What it does:
#   * refuses to start a second Calamares instance,
#   * waits (bounded) for the graphical session to settle before
#     escalating, so autostart does not race the desktop,
#   * logs what happened to /tmp/echoos-install-launcher.log so a failed
#     autostart is debuggable from a terminal,
#   * escalates through pkexec to the installer-owned wrapper
#     /usr/local/bin/echoos-calamares, which pins Qt to XWayland - never
#     by running the installer via sudo.

LOG=/tmp/echoos-install-launcher.log
SESSION_SETTLE_SECS=10

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"
}

# --- single instance -------------------------------------------------------
if pgrep -x calamares >/dev/null 2>&1; then
    log "calamares already running; not starting a second instance"
    exit 0
fi

# --- session readiness -----------------------------------------------------
# XDG autostart only runs inside an active session, but the desktop
# (panel, polkit agent) may still be coming up.  The polkit rule grants
# passwordless approval without an agent, so a bounded settle delay is
# all that is needed; if no XWayland display is present we bail out with
# a log entry instead of wedging the session.
if [ -z "${DISPLAY:-}" ] || [ -z "${XAUTHORITY:-}" ] || [ ! -r "${XAUTHORITY}" ]; then
    log "no usable XWayland display (DISPLAY='${DISPLAY:-}' XAUTHORITY='${XAUTHORITY:-}'); not starting"
    exit 1
fi
sleep "$SESSION_SETTLE_SECS"

if ! command -v calamares >/dev/null 2>&1; then
    log "calamares binary not found in PATH; image is broken"
    exit 127
fi
if ! command -v pkexec >/dev/null 2>&1; then
    log "pkexec not found; polkit missing from the image"
    exit 127
fi

# pkexec starts the installer with a sanitised environment: DISPLAY,
# XAUTHORITY and XDG_RUNTIME_DIR are dropped, so Calamares would abort
# with "could not connect to display".  Forward the live session's
# XWayland connection details explicitly through env(1); the wrapper
# pins QT_QPA_PLATFORM to xcb.
log "starting calamares (pkexec env DISPLAY=$DISPLAY /usr/local/bin/echoos-calamares)"
exec pkexec /usr/bin/env \
    DISPLAY="$DISPLAY" \
    XAUTHORITY="$XAUTHORITY" \
    XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    /usr/local/bin/echoos-calamares
