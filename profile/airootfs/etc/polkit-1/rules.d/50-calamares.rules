//
// Allow the live user to start the graphical installer without being
// asked for a password.
//
// The live account is passwordless, and the stock Calamares polkit
// action (io.calamares.calamares.policy) requires authentication as an
// administrator.  Without this rule the desktop launcher
// ("Applications -> Install System", Exec=pkexec calamares) would sit
// in front of an authentication dialog that can never be satisfied.
//
// This rule is excluded from the installed system (see
// /etc/calamares/modules/unpackfs/exclude-list.txt).

polkit.addRule(function (action, subject) {
    if (action.id === "io.calamares.calamares.pkexec.run" &&
        subject.user === "archiso" &&
        subject.local === true) {
        return polkit.Result.YES;
    }
});
