#!/bin/sh
# SPDX-FileCopyrightText: no
# SPDX-License-Identifier: CC0-1.0
#
# Apply the Echo OS wallpaper once per user, on the first Plasma login.
# Doing it here (instead of shipping a version-specific appletsrc) keeps the
# default layout intact and works on both the live session and installed
# systems.
set -eu

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
MARKER="$CONFIG_HOME/echoos-desktop-branded"
WALLPAPER=/usr/share/wallpapers/EchoOS/contents/images/2560x1280.jpg

[ -e "$MARKER" ] && exit 0
[ -r "$WALLPAPER" ] || exit 0
command -v plasma-apply-wallpaperimage >/dev/null 2>&1 || exit 0

mkdir -p "$CONFIG_HOME"

# The autostart entry runs as soon as the session starts, which can be before
# plasmashell has registered its D-Bus service.  Keep retrying for a bounded
# time and record success only after the wallpaper was actually applied, so a
# premature run does not permanently suppress branding on later logins.
attempt=0
while [ "$attempt" -lt 30 ]; do
    if plasma-apply-wallpaperimage "$WALLPAPER" >/dev/null 2>&1; then
        : > "$MARKER"
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 2
done

exit 0
