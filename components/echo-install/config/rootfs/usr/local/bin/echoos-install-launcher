#!/bin/sh
# SPDX-FileCopyrightText: no
# SPDX-License-Identifier: CC0-1.0
#
# Single entry point for launching the Echo OS installer from the live
# session.  Used by both the "Install Echo OS" desktop shortcut and the
# XDG autostart entry, so there is exactly one launch path to reason
# about.
#
# What it does:
#   * refuses to start a second Calamares instance,
#   * waits (bounded) for the graphical session to settle before
#     escalating, so autostart does not race the desktop,
#   * grants the root Calamares process access to the user's X display
#     when the live session is Plasma Wayland with Xwayland (root cannot
#     connect to a Wayland compositor directly),
#   * logs what happened to /tmp/echoos-install-launcher.log so a failed
#     autostart is debuggable from a terminal,
#   * escalates through pkexec, i.e. the stock Calamares polkit action
#     (io.calamares.calamares.pkexec.run) - never by running the
#     installer via sudo or a root wrapper.

LOG=/tmp/echoos-install-launcher.log
SESSION_SETTLE_SECS=10

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"
}

# --- single instance -------------------------------------------------------
if pgrep -x calamares >/dev/null 2>&1; then
    log "calamares already running; not starting a second instance"
    exit 0
fi

# --- session readiness -----------------------------------------------------
# XDG autostart only runs inside an active session, but the desktop
# (panel, polkit agent) may still be coming up.  The polkit rule grants
# passwordless approval without an agent, so a bounded settle delay is
# all that is needed; if neither an X display nor a Wayland display is
# present we bail out with a log entry instead of wedging the session.
#
# The delay is a *maximum* of SESSION_SETTLE_SECS: the loop polls every
# second and stops early as soon as polkitd is up (the 50-calamares.rules
# file approves the pkexec action without an authentication agent), so
# the installer window appears within a couple of seconds on a healthy
# live session instead of after a fixed 10-second sleep.
if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    log "no graphical display in the session; not starting"
    exit 1
fi
elapsed=0
while [ "$elapsed" -lt "$SESSION_SETTLE_SECS" ]; do
    if pgrep -x polkitd >/dev/null 2>&1; then
        sleep 2
        break
    fi
    sleep 1
    elapsed=$((elapsed + 1))
done

# Calamares runs as root through pkexec.  On Plasma Wayland that means it
# cannot talk to the user's Wayland compositor, so it falls back to Qt's
# XCB platform through Xwayland.  Grant root access to the X display; the
# operation is best-effort because a pure Wayland session has no Xwayland.
if [ -n "${DISPLAY:-}" ] && command -v xhost >/dev/null 2>&1; then
    xhost +SI:localuser:root >/dev/null 2>&1 || true
fi

if ! command -v calamares >/dev/null 2>&1; then
    log "calamares binary not found in PATH; image is broken"
    exit 127
fi
if ! command -v pkexec >/dev/null 2>&1; then
    log "pkexec not found; polkit missing from the image"
    exit 127
fi

log "starting calamares (pkexec)"
exec pkexec /usr/bin/calamares
