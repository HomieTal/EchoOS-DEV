#!/bin/bash
# Finalises the rEFInd boot setup of the freshly installed Echo OS system.
#
# Why this script exists:
#
# 1. `refind-install` (run by shellprocess-refindboot.conf) installs the
#    rEFInd loader to the ESP (mounted at /boot/efi by the installer's
#    partition layer) and, inside a chroot, may not leave a usable NVRAM
#    entry behind.  Most firmware falls back to the removable-media path
#    \EFI\BOOT\BOOTX64.EFI; without it the installed system cannot boot
#    at all (VMware reports "No compatible bootloader found").  So this
#    script publishes the same rEFInd loader as that fallback entry.
#
# 2. `refind-install` seeds /boot/refind_linux.conf from /proc/cmdline,
#    but the job runs chrooted into the target, where /proc/cmdline is
#    still the *live ISO's* archiso command line (root=/dev/loop0 and
#    friends) and cannot boot the installed system.  So this script
#    writes explicit parameters, derived from the target's own
#    /etc/fstab, right next to the installed kernel.
#
# 3. rEFInd 0.14.2's ext4 driver can list an ext4 volume and read small
#    files but fails with "Not Found" when it opens the multi-megabyte
#    kernel image (observed on VMware/OVMF with e2fsprogs 1.47 defaults).
#    Booting therefore never depends on that driver: the kernel and its
#    initramfs are copied to the ESP root (firmware-native FAT access)
#    and the ESP's refind.conf is replaced with a deterministic manual
#    menuentry that loads them from there.  /boot/refind_linux.conf is
#    still written for completeness.
#
# Runs inside the target chroot (see shellprocess-refindboot.conf); the
# target root prefix can be overridden with $ECHOO_PREFIX for testing.
#
# SPDX-License-Identifier: CC0-1.0

set -e

prefix="${ECHOO_PREFIX:-}"
fstab="${prefix}/etc/fstab"

if [ ! -f "$fstab" ]; then
    echo "ERROR: $fstab does not exist" >&2
    exit 1
fi

# --- locate the ESP mountpoint from the target fstab (vfat entry) -------
esp=""
while read -r src mountpoint fstype options _; do
    if [ "$fstype" = "vfat" ] && [ -n "$mountpoint" ]; then
        esp="${prefix}${mountpoint}"
        break
    fi
done < "$fstab"
if [ -z "$esp" ] || [ ! -d "$esp" ]; then
    echo "ERROR: no mounted ESP found in $fstab; cannot publish the fallback loader" >&2
    exit 1
fi

# --- locate the rEFInd loader that refind-install placed on the ESP -----
refind_src="$esp/EFI/refind/refind_x64.efi"
if [ ! -f "$refind_src" ]; then
    refind_src="/usr/share/refind/refind_x64.efi"
fi
if [ ! -f "$refind_src" ]; then
    echo "ERROR: rEFInd loader not found in $esp/EFI/refind or /usr/share/refind" >&2
    exit 1
fi

# --- publish it as the removable-media fallback \EFI\BOOT\BOOTX64.EFI ---
mkdir -p "$esp/EFI/BOOT"
install -m 0644 "$refind_src" "$esp/EFI/BOOT/BOOTX64.EFI"
if [ -f "$esp/EFI/refind/BOOT.CSV" ]; then
    install -m 0644 "$esp/EFI/refind/BOOT.CSV" "$esp/EFI/BOOT/BOOT.CSV"
fi
echo "echoos-refindconf-write: published $refind_src as $esp/EFI/BOOT/BOOTX64.EFI"

# --- locate the installed kernel and its directory -----------------------
kernel=""
for cand in "$prefix/boot/vmlinuz-linux" "$esp/vmlinuz-linux"; do
    if [ -f "$cand" ]; then
        kernel="$cand"
        break
    fi
done
if [ -z "$kernel" ]; then
    kernel="$(find "$prefix/boot" "$esp" -maxdepth 4 -name 'vmlinuz-linux' 2>/dev/null | head -n 1)"
fi
if [ -z "$kernel" ]; then
    echo "ERROR: no vmlinuz-linux under $prefix/boot or $esp; cannot write refind_linux.conf" >&2
    exit 1
fi
kdir="$(dirname "$kernel")"

rootsrc=""; rootfstype=""; rootoptions=""
while read -r src mountpoint fstype options _; do
    if [ "$mountpoint" = "/" ]; then
        rootsrc="$src"
        rootfstype="$fstype"
        rootoptions="$options"
        break
    fi
done < "$fstab"

if [ -z "$rootsrc" ]; then
    echo "ERROR: no / entry found in $fstab; cannot write refind_linux.conf" >&2
    exit 1
fi

rootcmd="root=$rootsrc"
if [ "$rootfstype" = "btrfs" ]; then
    subvol="$(echo "$rootoptions" | tr ',' '\n' | sed -n 's/^subvol=/subvol=/p' | head -n 1)"
    if [ -z "$subvol" ]; then
        echo "WARNING: btrfs / entry without subvol= in $fstab; rEFInd default subvolume will be used" >&2
    else
        rootcmd="root=$rootsrc rootflags=$subvol"
    fi
fi

cat > "$kdir/refind_linux.conf" <<EOF
"Boot with standard options"  "ro $rootcmd quiet splash"
"Boot to single-user mode"    "ro $rootcmd single"
"Boot with minimal options"   "ro $rootcmd"
EOF

chmod 644 "$kdir/refind_linux.conf"
echo "echoos-refindconf-write: wrote $kdir/refind_linux.conf with: rootcmd [$rootcmd]"

# --- publish the kernel and initramfs on the ESP root ---------------------
# The firmware reads FAT natively, so a kernel on the ESP boots without
# any filesystem driver.  The initramfs must sit next to the loader.
initrd_src="$kdir/initramfs-linux.img"
if [ ! -f "$initrd_src" ]; then
    echo "ERROR: no initramfs-linux.img next to the kernel; cannot copy boot files to the ESP" >&2
    exit 1
fi
install -m 0644 "$kernel" "$esp/vmlinuz-linux"
install -m 0644 "$initrd_src" "$esp/initramfs-linux.img"
echo "echoos-refindconf-write: published $(basename "$kernel") and $(basename "$initrd_src") on $esp"

cat > "$esp/refind_linux.conf" <<EOF
"Boot with standard options"  "ro $rootcmd quiet splash"
"Boot to single-user mode"    "ro $rootcmd single"
"Boot with minimal options"   "ro $rootcmd"
EOF
chmod 644 "$esp/refind_linux.conf"

# --- write the deterministic rEFInd configuration -------------------------
# refind-install leaves the 36 KB sample refind.conf on the ESP, whose
# auto-scan produces a dead "boot\vmlinuz-linux from root" entry for the
# ext4 /boot that the ext4 driver cannot actually load.  Replace it with
# a manual menuentry for the ESP kernel so the boot path is explicit.
# The same file is written to EFI/BOOT for the fallback loader, whose
# paths must be self-contained.
refind_conf_body=$(cat <<EOF
# Echo OS installed-system boot configuration.
# Written by /usr/local/sbin/echoos-refindconf-write at install time.
timeout 5
default_selection "Echo OS"
showtools shutdown,reboot,firmware
scanfor manual

menuentry "Echo OS" {
    icon \\EFI\\refind\\icons\\os_arch.png
    loader \\vmlinuz-linux
    initrd \\initramfs-linux.img
    options "ro $rootcmd quiet splash"
}
EOF
)
printf '%s\n' "$refind_conf_body" > "$esp/EFI/refind/refind.conf"
printf '%s\n' "$refind_conf_body" > "$esp/EFI/BOOT/refind.conf"
chmod 644 "$esp/EFI/refind/refind.conf" "$esp/EFI/BOOT/refind.conf"
echo "echoos-refindconf-write: wrote manual boot menu to EFI/refind/refind.conf and EFI/BOOT/refind.conf"
